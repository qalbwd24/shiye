{
  "name": "diary-desktop-preview",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node tools/dev-server.mjs",
    "test": "node tools/test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:files && npm run lint && npm run format:check && npm test",
    "check:files": "node tools/check-files.mjs",
    "build:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-launcher.ps1",
    "package:source": "node tools/package-source.mjs",
    "build:editor": "node tools/build-editor.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@lezer/highlight": "1.2.3",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "turndown": "7.2.4"
  },
  "description": "拾页：本地日记、旧格式导入与加密备份"
}
