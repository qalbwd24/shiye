{
  "type": "object",
  "properties": {
    "format": {
      "const": "shiye-unified-data"
    },
    "schemaVersion": {
      "const": 1
    },
    "stage": {
      "const": "design-draft"
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/category"
      }
    },
    "conversations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/conversation"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/asset"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/record"
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/page"
      }
    },
    "revisitRules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/rule"
      }
    },
    "revisitContexts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/context"
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "stage",
    "categories",
    "conversations",
    "assets",
    "records",
    "pages",
    "revisitRules",
    "revisitContexts"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:shiye:design:unified-data:v1",
  "title": "拾页统一数据契约 v1 讨论草案",
  "$comment": "Design only. Not a runtime schema, migration or complete portable backup. Cross-record invariants require separate checks.",
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "sourceRef": {
      "type": "object",
      "properties": {
        "recordId": {
          "$ref": "#/definitions/id"
        },
        "blockId": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["recordId", "blockId", "observedRevision"],
      "additionalProperties": false
    },
    "category": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "pickers": {
          "type": "array",
          "items": {
            "enum": ["diary", "chat"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["id", "name", "pickers", "order"],
      "additionalProperties": false
    },
    "conversation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "enum": ["journal", "revisit"]
        },
        "defaultCategoryId": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "idleSeconds": {
          "type": "integer",
          "minimum": 360,
          "maximum": 31536000
        }
      },
      "required": ["id", "name", "kind", "defaultCategoryId", "idleSeconds"],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "fileName": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "blobRef": {
          "$ref": "#/definitions/id"
        }
      },
      "required": ["id", "fileName", "mediaType", "size", "sha256", "blobRef"],
      "additionalProperties": false
    },
    "eventTime": {
      "type": "object",
      "properties": {
        "instant": {
          "anyOf": [
            {
              "$ref": "#/definitions/utc"
            },
            {
              "type": "null"
            }
          ]
        },
        "local": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeZone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "enum": ["millisecond", "second", "minute", "day", "unknown"]
        },
        "source": {
          "enum": [
            "message-send",
            "diary-date",
            "manual-marker",
            "image-insertion",
            "comment-created",
            "legacy-unknown"
          ]
        }
      },
      "required": ["instant", "local", "timeZone", "precision", "source"],
      "additionalProperties": false
    },
    "mark": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "bold",
            "italic",
            "highlight",
            "strike",
            "code",
            "underline",
            "link",
            "subscript",
            "superscript"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "href": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "nodeAttrs": {
      "type": "object",
      "properties": {
        "blockId": {
          "$ref": "#/definitions/id"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "language": {
          "type": "string"
        },
        "checked": {
          "type": "boolean"
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "align": {
          "enum": ["left", "center", "right", "justify"]
        },
        "assetId": {
          "$ref": "#/definitions/id"
        },
        "occurrenceId": {
          "$ref": "#/definitions/id"
        },
        "insertedAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/utc"
            },
            {
              "type": "null"
            }
          ]
        },
        "widthRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "caption": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "instant": {
          "anyOf": [
            {
              "$ref": "#/definitions/utc"
            },
            {
              "type": "null"
            }
          ]
        },
        "local": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeZone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["blockId"],
      "additionalProperties": false
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            },
            "marks": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/mark"
              }
            }
          },
          "required": ["type", "text"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "paragraph",
                "heading",
                "bulletList",
                "orderedList",
                "listItem",
                "taskList",
                "taskItem",
                "blockquote",
                "codeBlock",
                "table",
                "tableRow",
                "tableCell",
                "tableHeader",
                "horizontalRule",
                "image",
                "video",
                "audio",
                "file",
                "timeMarker",
                "hardBreak"
              ]
            },
            "attrs": {
              "$ref": "#/definitions/nodeAttrs"
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/node"
              }
            }
          },
          "required": ["type", "attrs"],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "enum": ["image", "video", "audio", "file"]
                  }
                },
                "required": ["type"]
              },
              "then": {
                "properties": {
                  "attrs": {
                    "required": ["assetId", "occurrenceId", "insertedAt"]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "heading"
                  }
                },
                "required": ["type"]
              },
              "then": {
                "properties": {
                  "attrs": {
                    "required": ["level"]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "timeMarker"
                  }
                },
                "required": ["type"]
              },
              "then": {
                "properties": {
                  "attrs": {
                    "required": ["instant", "local", "timeZone"]
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "document": {
      "type": "object",
      "properties": {
        "format": {
          "const": "shiye-richdoc"
        },
        "version": {
          "const": 1
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          },
          "minItems": 1
        }
      },
      "required": ["format", "version", "content"],
      "additionalProperties": false
    },
    "origin": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["diary", "chat", "revisit"]
        },
        "conversationId": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "legacyKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["kind", "conversationId", "legacyKey"],
      "additionalProperties": false
    },
    "author": {
      "type": "object",
      "properties": {
        "subjectId": {
          "$ref": "#/definitions/id"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "avatarAssetId": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["subjectId", "displayName", "avatarAssetId"],
      "additionalProperties": false
    },
    "commentTarget": {
      "type": "object",
      "properties": {
        "pageId": {
          "$ref": "#/definitions/id"
        },
        "scope": {
          "enum": ["page", "record", "block", "image"]
        },
        "recordId": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "blockId": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurrenceId": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["pageId", "scope", "recordId", "blockId", "occurrenceId", "observedRevision"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "page"
              }
            },
            "required": ["scope"]
          },
          "then": {
            "properties": {
              "recordId": {
                "type": "null"
              },
              "blockId": {
                "type": "null"
              },
              "occurrenceId": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "record"
              }
            },
            "required": ["scope"]
          },
          "then": {
            "properties": {
              "recordId": {
                "$ref": "#/definitions/id"
              },
              "blockId": {
                "type": "null"
              },
              "occurrenceId": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "block"
              }
            },
            "required": ["scope"]
          },
          "then": {
            "properties": {
              "recordId": {
                "$ref": "#/definitions/id"
              },
              "blockId": {
                "$ref": "#/definitions/id"
              },
              "occurrenceId": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "image"
              }
            },
            "required": ["scope"]
          },
          "then": {
            "properties": {
              "recordId": {
                "$ref": "#/definitions/id"
              },
              "blockId": {
                "$ref": "#/definitions/id"
              },
              "occurrenceId": {
                "$ref": "#/definitions/id"
              }
            }
          }
        }
      ]
    },
    "commentOn": {
      "type": "object",
      "properties": {
        "contextId": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "enum": ["group", "single"]
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/commentTarget"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["contextId", "mode", "targets"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "single"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "targets": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "group"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "contextId": {
                "$ref": "#/definitions/id"
              }
            }
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "kind": {
          "enum": ["diary", "message", "comment"]
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "categoryId": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "$ref": "#/definitions/origin"
        },
        "author": {
          "$ref": "#/definitions/author"
        },
        "visibility": {
          "type": "object",
          "properties": {
            "hidden": {
              "type": "boolean"
            },
            "draft": {
              "type": "boolean"
            }
          },
          "required": ["hidden", "draft"],
          "additionalProperties": false
        },
        "body": {
          "anyOf": [
            {
              "$ref": "#/definitions/document"
            },
            {
              "type": "null"
            }
          ]
        },
        "eventTime": {
          "$ref": "#/definitions/eventTime"
        },
        "createdAt": {
          "$ref": "#/definitions/utc"
        },
        "updatedAt": {
          "$ref": "#/definitions/utc"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": ["active", "withdrawn", "deleted"]
        },
        "withdrawnAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/utc"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "replyTo": {
          "anyOf": [
            {
              "$ref": "#/definitions/sourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "supersedesId": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "commentOn": {
          "anyOf": [
            {
              "$ref": "#/definitions/commentOn"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "categoryId",
        "origin",
        "author",
        "visibility",
        "body",
        "eventTime",
        "createdAt",
        "updatedAt",
        "revision",
        "state",
        "withdrawnAt",
        "sequence",
        "replyTo",
        "supersedesId",
        "commentOn"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "withdrawn"
              }
            },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "message"
              },
              "body": {
                "type": "null"
              },
              "withdrawnAt": {
                "$ref": "#/definitions/utc"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "active"
              }
            },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/definitions/document"
              },
              "withdrawnAt": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "comment"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "commentOn": {
                "$ref": "#/definitions/commentOn"
              },
              "replyTo": {
                "type": "null"
              },
              "supersedesId": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["diary", "message"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "commentOn": {
                "type": "null"
              },
              "categoryId": {
                "$ref": "#/definitions/id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["message", "comment"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "title": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "diary"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 500
              },
              "origin": {
                "properties": {
                  "kind": {
                    "const": "diary"
                  },
                  "conversationId": {
                    "type": "null"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "message"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "origin": {
                "properties": {
                  "kind": {
                    "const": "chat"
                  },
                  "conversationId": {
                    "$ref": "#/definitions/id"
                  }
                }
              },
              "sequence": {
                "type": "string",
                "pattern": "^[0-9]+$"
              }
            }
          }
        }
      ]
    },
    "grouping": {
      "type": "object",
      "properties": {
        "idleSeconds": {
          "type": "integer",
          "minimum": 360,
          "maximum": 31536000
        },
        "firstAt": {
          "$ref": "#/definitions/utc"
        },
        "lastAt": {
          "$ref": "#/definitions/utc"
        },
        "state": {
          "enum": ["open", "closed"]
        }
      },
      "required": ["idleSeconds", "firstAt", "lastAt", "state"],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "kind": {
          "enum": ["diary", "chat-segment"]
        },
        "categoryId": {
          "$ref": "#/definitions/id"
        },
        "conversationId": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "recordIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "bodyPolicy": {
          "enum": ["document-editable", "derived-read-only"]
        },
        "grouping": {
          "anyOf": [
            {
              "$ref": "#/definitions/grouping"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "categoryId",
        "conversationId",
        "recordIds",
        "bodyPolicy",
        "grouping"
      ],
      "additionalProperties": false,
      "allOf": [
        {
